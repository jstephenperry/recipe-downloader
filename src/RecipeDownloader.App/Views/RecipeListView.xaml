<UserControl x:Class="RecipeDownloader.App.Views.RecipeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RecipeDownloader.App.Converters"
             xmlns:vm="clr-namespace:RecipeDownloader.App.ViewModels;assembly=RecipeDownloader.App.Shared">
    <UserControl.Resources>
        <converters:DownloadStatusToTextConverter x:Key="StatusToText"/>
        <converters:DownloadStatusToColorConverter x:Key="StatusToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Action Bar -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="Discover Recipes" Command="{Binding DiscoverCommand}"
                    Style="{StaticResource ActionButton}"/>
            <Button Content="Download Selected" Command="{Binding DownloadSelectedCommand}"
                    Style="{StaticResource ActionButton}"/>
            <Button Content="Download All" Command="{Binding DownloadAllCommand}"
                    Style="{StaticResource ActionButton}"/>
            <Button Content="Cancel" Command="{Binding CancelOperationCommand}"
                    Style="{StaticResource ActionButton}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <Separator Width="12" Visibility="Hidden"/>
            <Button Content="Select All" Command="{Binding SelectAllCommand}"
                    Style="{StaticResource ActionButton}" MinWidth="80"/>
            <Button Content="Select None" Command="{Binding SelectNoneCommand}"
                    Style="{StaticResource ActionButton}" MinWidth="80"/>
        </WrapPanel>

        <!-- Recipe DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Recipes}"
                  SelectedItem="{Binding SelectedRecipe}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F8F8F8"
                  RowHeight="28"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                <DataGridTextColumn Header="Recipe Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="PDF" Binding="{Binding HasPdf}" Width="50" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Status" Width="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status / Progress -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <ProgressBar Grid.Column="1" Height="16"
                         Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
