<Window x:Class="RecipeDownloader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RecipeDownloader.App.Views"
        xmlns:vm="clr-namespace:RecipeDownloader.App.ViewModels"
        Title="Recipe Downloader" Width="1000" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="8" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Output:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button DockPanel.Dock="Right" Content="Browse..."
                        Command="{Binding BrowseOutputDirectoryCommand}"
                        Padding="10,4" Margin="6,0,0,0"/>
                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="4,2" IsReadOnly="True"/>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Provider Sidebar -->
            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Providers" FontWeight="Bold" FontSize="13"
                               Margin="10,10,10,6"/>
                    <ListBox ItemsSource="{Binding Providers}"
                             SelectedItem="{Binding SelectedProvider}"
                             BorderThickness="0" Background="Transparent"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
                                <StackPanel Margin="4,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Recipes.Count, StringFormat='{}{0} recipes'}"
                                               FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Content Area -->
            <Grid Grid.Column="2" Margin="10" DataContext="{Binding SelectedProvider}">
                <TextBlock Text="Select a provider from the sidebar"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180" MinHeight="100"/>
                    </Grid.RowDefinitions>

                    <views:RecipeListView Grid.Row="0"/>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" Background="Transparent"/>

                    <views:RecipeDetailView Grid.Row="2" DataContext="{Binding SelectedRecipe}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
