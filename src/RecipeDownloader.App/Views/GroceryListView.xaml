<UserControl x:Class="RecipeDownloader.App.Views.GroceryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RecipeDownloader.App.Converters"
             xmlns:vm="clr-namespace:RecipeDownloader.App.ViewModels">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" Style="{StaticResource SectionHeader}">
            <Run Text="Grocery List"/>
        </TextBlock>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10">
            <Run Text="{Binding Recipe1Title, Mode=OneWay}"/>
            <Run Text=" + "/>
            <Run Text="{Binding Recipe2Title, Mode=OneWay}"/>
        </TextBlock>

        <!-- Grouped grocery items -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <Border Background="#E8E8E8" Padding="8,4" Margin="0,0,0,4">
                                    <TextBlock FontWeight="SemiBold" FontSize="13">
                                        <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                        <Run Text=" (" Foreground="Gray"/>
                                        <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="Gray"/>
                                        <Run Text=")" Foreground="Gray"/>
                                    </TextBlock>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4,8,4" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}"
                                                               VerticalAlignment="Center" Foreground="Gray"/>
                                                    <Border Grid.Column="3" Background="#C8E6C9" CornerRadius="3"
                                                            Padding="6,2" Margin="4,0,0,0"
                                                            Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="shared" FontSize="10" Foreground="#2E7D32"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- On-hand section -->
                <StackPanel Visibility="{Binding OnHandItems.Count, Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">
                    <Border Background="#FFF3E0" Padding="8,4" Margin="0,0,0,4">
                        <TextBlock FontWeight="SemiBold" FontSize="13" Text="Already On Hand"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding OnHandItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4,8,4" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Name}" Foreground="Gray"
                                               TextDecorations="Strikethrough"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Copy to Clipboard" Command="{Binding CopyToClipboardCommand}"
                    Style="{StaticResource ActionButton}"/>
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="{Binding SummaryText}" Margin="0,6,0,0"
                   FontWeight="SemiBold" Foreground="#555"/>
    </Grid>
</UserControl>
