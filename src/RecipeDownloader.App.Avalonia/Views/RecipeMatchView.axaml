<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RecipeDownloader.App.Avalonia.Views.RecipeMatchView">

    <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" FontSize="18" Classes="sectionHeader">
            <Run Text="Recipe Matches: "/>
            <Run Text="{Binding Protein1, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text=" + "/>
            <Run Text="{Binding Protein2, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                   Text="Pairs ranked by ancillary ingredient overlap. Select a pair to generate a grocery list."/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Matches}"
                  SelectedItem="{Binding SelectedMatch}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Recipe 1" Binding="{Binding Recipe1Title}" Width="*"/>
                <DataGridTextColumn Header="Recipe 2" Binding="{Binding Recipe2Title}" Width="*"/>
                <DataGridTextColumn Header="Shared" Binding="{Binding SharedCount}" Width="60"/>
                <DataGridTextColumn Header="Overlap" Binding="{Binding ScoreDisplay}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detail for the selected match -->
        <Border Grid.Row="3" Padding="8" Background="#F5F5F5" Margin="0,8,0,0"
                IsVisible="{Binding SelectedMatch, Converter={StaticResource NotNull}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap">
                    <Run Text="Shared ingredients: "/>
                    <Run Text="{Binding SelectedMatch.SharedDisplay, Mode=OneWay}" Foreground="#2E7D32"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                    <Run Text="Only in " FontWeight="SemiBold"/>
                    <Run Text="{Binding SelectedMatch.Recipe1Title, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=": "/>
                    <Run Text="{Binding SelectedMatch.UniqueToR1Display, Mode=OneWay}" Foreground="#C62828"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Only in " FontWeight="SemiBold"/>
                    <Run Text="{Binding SelectedMatch.Recipe2Title, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=": "/>
                    <Run Text="{Binding SelectedMatch.UniqueToR2Display, Mode=OneWay}" Foreground="#C62828"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button Content="Generate Grocery List" Command="{Binding SelectPairCommand}"
                    Classes="action" FontWeight="SemiBold"/>
        </WrapPanel>

        <TextBlock Grid.Row="5" Text="{Binding StatusText}" Margin="0,6,0,0" Foreground="Gray"/>
    </Grid>
</UserControl>
