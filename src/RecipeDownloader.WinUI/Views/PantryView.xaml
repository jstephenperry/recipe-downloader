<UserControl
    x:Class="RecipeDownloader.WinUI.Views.PantryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RecipeDownloader.ViewModels">

    <Grid x:Name="PantryRoot" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pantry Inventory" Style="{StaticResource SectionHeader}" />
        <TextBlock Grid.Row="1"
                   Text="Track ingredients you already have. These will be subtracted from your grocery list."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Add ingredient form -->
        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding NewItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Ingredient name..." />
            <TextBox Grid.Column="1" Text="{Binding NewItemQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Qty" />
            <TextBox Grid.Column="2" Text="{Binding NewItemUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Unit" />
            <Button Grid.Column="3" Content="Add" Command="{Binding AddItemCommand}" MinWidth="70" />
        </Grid>

        <!-- Pantry items list -->
        <ListView Grid.Row="3" ItemsSource="{Binding Items}" SelectionMode="None"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PantryItemViewModel">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding QuantityDisplay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="2" Content="Remove" Padding="8,2"
                                Command="{Binding DataContext.RemoveItemCommand, ElementName=PantryRoot}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Clear All" Command="{Binding ClearAllCommand}"
                    Style="{StaticResource ActionButton}" />
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding StatusText}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
