<Window
    x:Class="RecipeDownloader.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:RecipeDownloader.WinUI.Views"
    xmlns:vm="using:RecipeDownloader.ViewModels">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding OutputDirectory, Mode=OneWay}"
                     IsReadOnly="True" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..."
                    Command="{Binding BrowseOutputDirectoryCommand}" />
        </Grid>

        <!-- Navigation + Content -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        ItemInvoked="Nav_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Recipes" Tag="Recipes" Icon="Library" IsSelected="True" />
                <NavigationViewItem Content="Pantry" Tag="Pantry" Icon="Shop" />
                <NavigationViewItem Content="Meal Planner" Tag="MealPlanner" Icon="Calendar" />
            </NavigationView.MenuItems>

            <Grid>
                <!-- Recipes View -->
                <Grid Visibility="{Binding ActiveView, Converter={StaticResource ViewVis}, ConverterParameter=Recipes}"
                      ColumnSpacing="8" Padding="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Provider list -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Providers" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListView ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderViewModel">
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding Recipes.Count}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="recipes" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Provider content -->
                    <Grid Grid.Column="1" DataContext="{Binding SelectedProvider}"
                          Visibility="{Binding Converter={StaticResource NullToVis}}"
                          RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <views:RecipeListView Grid.Row="0" />
                        <views:RecipeDetailView Grid.Row="1" DataContext="{Binding SelectedRecipe}" />
                    </Grid>
                </Grid>

                <!-- Pantry View -->
                <views:PantryView DataContext="{Binding PantryViewModel}"
                                  Visibility="{Binding DataContext.ActiveView, ElementName=Root, Converter={StaticResource ViewVis}, ConverterParameter=Pantry}" />

                <!-- Protein Picker View -->
                <views:ProteinPickerView DataContext="{Binding ProteinPickerViewModel}"
                                         Visibility="{Binding DataContext.ActiveView, ElementName=Root, Converter={StaticResource ViewVis}, ConverterParameter=MealPlanner}" />

                <!-- Recipe Match View -->
                <views:RecipeMatchView DataContext="{Binding RecipeMatchViewModel}"
                                       Visibility="{Binding DataContext.ActiveView, ElementName=Root, Converter={StaticResource ViewVis}, ConverterParameter=RecipeMatch}" />

                <!-- Grocery List View -->
                <views:GroceryListView DataContext="{Binding GroceryListViewModel}"
                                       Visibility="{Binding DataContext.ActiveView, ElementName=Root, Converter={StaticResource ViewVis}, ConverterParameter=GroceryList}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
