<Project>

  <PropertyGroup>
    <!--
      The WPF host targets net10.0-windows. Setting this lets the whole solution restore and
      build from Linux and macOS as well, so the cross-platform projects can be built and
      tested anywhere without passing -p:EnableWindowsTargeting=true on every invocation.
      The WPF application itself still only runs on Windows.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
